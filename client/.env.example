# Copy to .env. Both values are compiled into the bundle, so neither is secret.

# In production this must be "/api" so the API is same-origin: the session
# cookie is sameSite=lax and a browser will not attach it cross-site. The
# rewrite in vercel.json forwards /api/* to the backend for that reason.
VITE_API_BASE_URL=http://localhost:5000

# Must match the server's GOOGLE_CLIENT_ID exactly. Leave empty to hide the
# Google button; guest sign-in still works.
VITE_GOOGLE_CLIENT_ID=
