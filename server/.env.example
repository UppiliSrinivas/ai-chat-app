# Copy to .env and fill in real values. Never commit .env.
# Loaded from the working directory, so start the server from server/.

# Required. The process refuses to boot without these rather than failing on
# the first request.
GEMINI_API_KEY=
JWT_SECRET=

# Required for whichever NODE_ENV you run under. Dev is a separate variable so
# a local `npm run dev` can never reach the production database.
MONGODB_URI_DEV=
MONGODB_URI_PROD=

# Optional. With none of them set, POST /auth/google answers 503 and the other
# sign-in methods still work. Not secrets — they ship in client bundles — but
# each is checked as a token's `aud`, so a wrong value rejects every sign-in.
# GOOGLE_CLIENT_ID must equal the client's VITE_GOOGLE_CLIENT_ID exactly; the
# platform ones exist because a native OAuth client stamps its own audience.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=

# Optional, shown with their defaults.
PORT=5000
NODE_ENV=development
GEMINI_MODEL=gemini-3-flash-preview
JWT_EXPIRES_IN=7d

# Comma-separated allowlist, picked by NODE_ENV. Never widen to "*" — the
# server holds the provider key and issues the session cookie.
CORS_ORIGIN_DEV=http://localhost:5173
CORS_ORIGIN_PROD=
